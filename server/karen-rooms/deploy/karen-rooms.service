[Unit]
Description=Karen STS2 room-code relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/karen-rooms/current
ExecStart=/opt/karen-rooms/venv/bin/python server.py --host 127.0.0.1 --port 42766
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
TasksMax=32
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
