<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <PlatformTarget Condition="'$(KarenAndroidBuild)' != 'true'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(KarenAndroidBuild)' == 'true'">AnyCPU</PlatformTarget>
    <DefineConstants Condition="'$(KarenAndroidBuild)' == 'true'">$(DefineConstants);KAREN_ANDROID</DefineConstants>
    <Sts2Api Condition="'$(Sts2Api)' == ''">stable</Sts2Api>
    <DefineConstants Condition="'$(Sts2Api)' == 'beta'">$(DefineConstants);STS2_BETA</DefineConstants>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">D:\App\Stream\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <CoreApiPath Condition="'$(CoreApiPath)' == ''">$(MSBuildProjectDirectory)/vendor/core-sdk/api/ShoujoKagekiAijoCore.Api.V1.dll</CoreApiPath>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" Exclude="src\**\bin\**;src\**\obj\**" />
    <EmbeddedResource Remove="audio\**" />
    <EmbeddedResource Remove="fonts\**" />
    <EmbeddedResource Remove="images\**" />
    <EmbeddedResource Remove="materials\**" />
    <EmbeddedResource Remove="scenes\**" />
    <EmbeddedResource Remove="shaders\**" />
    <EmbeddedResource Remove="ShoujoKagekiAijoKaren\**" />
    <EmbeddedResource Remove="themes\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ShoujoKagekiAijoKaren.json" />
    <Content Include="mod_manifest.json" />

  </ItemGroup>
  <ItemGroup>
    <Reference Include="ShoujoKagekiAijoCore.Api.V1" HintPath="$(CoreApiPath)" Private="false" />
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.7" />
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="0.107.1" PrivateAssets="All" Condition="'$(Sts2Api)' == 'stable' and '$(Sts2ReferenceMode)' == 'package'" />
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="0.111.0-beta-41cef1ea" PrivateAssets="All" Condition="'$(Sts2Api)' == 'beta' and '$(Sts2ReferenceMode)' == 'package'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Sts2ReferenceMode)' != 'package'">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EditorConfigFiles Remove="D:\Godot\Proj\STS2_ShoujoKagekiAijoKaren\.editorconfig" />
  </ItemGroup>
  <Target Name="RequireCoreSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CoreApiPath)')" Text="Core V1 SDK is required. Set CoreApiPath to the API assembly in the official Core package." />
  </Target>
</Project>
