<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KarenObservationRegression</AssemblyName>
    <Variant Condition="'$(Variant)' == ''">Beta</Variant>
    <Game>$(MSBuildThisFileDirectory)../../artifacts/dev-game/$(Variant)/game</Game>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Game)/data_sts2_windows_x86_64/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Game)/data_sts2_windows_x86_64/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Game)/data_sts2_windows_x86_64/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Karen"><HintPath>../../artifacts/dev-game/$(Variant)/game/mods/ShoujoKagekiAijoKaren/lib/ShoujoKagekiAijoKaren.$(Variant).dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
